{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)", "Bash(npm test*)", "Bash(npm ci)", "Bash(npm install*)", "Bash(npm view *)",
      "Bash(npx tsc *)", "Bash(npx vite *)", "Bash(npx vitest *)", "Bash(npx biome *)", "Bash(npx playwright *)",
      "Bash(node *)", "Bash(git *)",
      "Bash(gh pr *)", "Bash(gh run *)", "Bash(gh repo view*)"
    ],
    "ask": ["Bash(git reset --hard*)", "Bash(git clean *)"],
    "deny": [
      "Read(./private/**)", "Edit(./private/**)",
      "Read(~/Statements/**)", "Edit(~/Statements/**)",
      "Bash(git push --force*)", "Bash(git push -f *)", "Bash(gh pr merge * --admin*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": { "denyRead": ["./private", "~/Statements"] },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org", "*.npmjs.org", "github.com", "*.github.com", "*.githubusercontent.com",
        "cdn.playwright.dev", "playwright.download.prss.microsoft.com"
      ]
    },
    "excludedCommands": ["gh *", "git push *", "git fetch *", "git pull *", "npm run e2e*", "npx playwright *"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"", "timeout": 30 }] }
    ]
  },
  "env": { "ECC_GATEGUARD": "off" },
  "enabledPlugins": { "claude-mem@thedotmack": false, "claude-mem-cowork@thedotmack": false }
}
